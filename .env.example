# ==========================================
# Hasib Enterprises - Environment Variables
# ==========================================

# Mode Switch
# Set to true for local testing with rich pre-seeded data without Supabase credentials.
# In production, set to false; if Supabase credentials are missing, an error notice is displayed.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Credentials
# Fill these in when connecting to your live Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for secure server-side admin operations if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
